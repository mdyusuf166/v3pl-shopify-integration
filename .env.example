# =============================================================================
# Environment variables template.
# Copy to .env.local for development. Configure real values in Vercel for prod.
# NEVER commit real values. Only this .env.example file is committed.
# =============================================================================

# --- Database (PostgreSQL — Neon or equivalent) ------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Direct (non-pooled) connection for Prisma migrations, if provider requires it
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Firebase (client SDK — safe to expose, but keep out of git anyway) ------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin SDK (server-only — SECRET) --------------------------------
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Private key with literal \n newlines escaped
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Cloudinary (server-only secret; needed from Phase 3) --------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Shopify (single public OAuth app; see docs/shopify-setup.md Part E) ------
# Client ID from Dev Dashboard → app → Settings (not secret, but keep out of git)
SHOPIFY_API_KEY=""
# Client secret — server-only SECRET (OAuth token exchange + webhook HMAC)
SHOPIFY_API_SECRET=""
# Pinned Admin GraphQL API version
SHOPIFY_API_VERSION="2026-07"
# Minimum scopes (D-023) — must match the Dev Dashboard configuration exactly
SHOPIFY_SCOPES="read_orders,write_orders,write_merchant_managed_fulfillment_orders,read_fulfillments,read_products,write_inventory,read_locations,read_customers"
# 32-byte base64 key for AES-256-GCM encryption of per-store access/refresh tokens
# generate: openssl rand -base64 32   (losing it forces every store to reconnect)
SHOPIFY_TOKEN_ENCRYPTION_KEY=""
# Bearer secret protecting /api/cron/* routes (Vercel Cron or external scheduler)
CRON_SECRET=""

# --- App ----------------------------------------------------------------------
# Canonical public URL. OPTIONAL on Vercel: the app derives it from the system
# variables VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL (D-042), so leave it unset
# there. Set it locally, for custom domains or when self-hosting.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
